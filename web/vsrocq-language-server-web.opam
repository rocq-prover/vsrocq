# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "The VsRocq language server compiled to WebAssembly"
description: """
The VsRocq language server compiled with wasm_of_ocaml, to run in a Web Worker
(e.g. in VS Code for the web) or a node worker thread. It uses the libraries,
plugins and .vo files of the Rocq installed in the same switch: plugins are
loaded with Dynlink. Proof delegation is not available."""
maintainer: ["The VsRocq development team"]
authors: ["The VsRocq development team"]
license: "LGPL-2.1-only"
homepage: "https://github.com/rocq-prover/vsrocq"
bug-reports: "https://github.com/rocq-prover/vsrocq/issues"
depends: [
  "dune" {>= "3.21"}
  "vsrocq-language-server"
  "rocq-web"
  "zarith_stubs_js"
  "js_of_ocaml" {>= "6.5"}
  "js_of_ocaml-ppx" {>= "6.5"}
  "wasm_of_ocaml-compiler" {>= "6.5"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rocq-prover/vsrocq.git"
x-maintenance-intent: ["(latest)"]
