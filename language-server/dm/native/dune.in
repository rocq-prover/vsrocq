; Implementation of the virtual modules of dm based on threads (to interrupt
; Rocq) and Unix processes (to delegate proofs to workers)
(library
 (name dm_native)
 (public_name vsrocq-language-server.dm.native)
 (implements dm)
 (preprocess (pps ppx_optcomp -- -cookie "ppx_optcomp.env=env ~rocq:(Defined \"@@ROCQVERSION@@\")"))
 (libraries @@ROCQ_RUNTIME@@.sysinit @@ROCQ_RUNTIME@@.vernac sel str threads memprof-limits))
