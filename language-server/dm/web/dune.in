; Implementation of the virtual modules of dm for wasm_of_ocaml: no threads,
; Rocq runs in the main thread and polls for interruptions, no proof delegation
(library
 (name dm_web)
 (public_name vsrocq-language-server.dm.web)
 (implements dm)
 (preprocess (pps ppx_optcomp -- -cookie "ppx_optcomp.env=env ~rocq:(Defined \"@@ROCQVERSION@@\")"))
 (libraries @@ROCQ_RUNTIME@@.sysinit @@ROCQ_RUNTIME@@.vernac sel unix))
